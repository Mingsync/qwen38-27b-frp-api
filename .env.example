# Copy to .env on the Linux server. No API key belongs in this file.
# Official v0.32.0 multi-platform index, resolved 2026-10-28.
VLLM_IMAGE=vllm/vllm-openai@sha256:befccf0e7e4089aa23926bb6f887a85c0d46c2a99e6de5c5ffdf5cb7957c5b34
MODEL_ID=Qwen/Qwen3.8-27B-FP8
MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
MODEL_DIR=/srv/models/Qwen3.8-27B-FP8
SERVED_MODEL_NAME=qwen3.8-27b
# Host publication address; the process inside Docker listens on 0.0.0.0:8000.
BIND_HOST=127.0.0.1
API_PORT=8000
# Client configuration only: this does not create DNS or change server binding.
API_BASE_URL=http://127.0.0.1:8000/v1
GPU_0=0
GPU_1=1
TENSOR_PARALLEL_SIZE=2
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2048
# Output cap is per generated sequence; use a gateway for per-user quotas.
MAX_OUTPUT_TOKENS=1024
# Running + waiting HTTP requests, independently of MAX_NUM_SEQS.
MAX_NUM_QUEUED_REQS=8
ENABLE_THINKING=0
SSE_KEEP_ALIVE_INTERVAL=15
EAGER=1
PREFIX_CACHING=0
TEXT_ONLY=1
CPU_OFFLOAD_GB=0
OMP_NUM_THREADS=8
# Leave these at 0; use 1 only for targeted communication troubleshooting.
NCCL_P2P_DISABLE=0
NCCL_IB_DISABLE=0
